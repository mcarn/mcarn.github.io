---
import { SITE_CONFIG } from "../utils/constants"

const currentPath = Astro.url.pathname
---

<header class="flex justify-center bg-[var(--color-bg-accent)] p-4 sticky top-0 z-50">
  <nav class="m-0 flex list-none gap-8 p-0">
    {
      SITE_CONFIG.nav.map((item) => {
        const isActive = currentPath === item.href || (item.href === "/" && currentPath === "/")
        return (
          <li class="relative">
            <a
              href={item.href}
              class={`rounded-md px-4 py-2 font-medium no-underline transition-all duration-300 ${
                isActive
                  ? "bg-gradient-primary text-white shadow-lg"
                  : "text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
              }`}
            >
              {item.text}
            </a>
          </li>
        )
      })
    }
  </nav>
</header>
