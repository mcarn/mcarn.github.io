---
import Layout from "../layouts/Layout.astro"
---

<Layout>
  <script>
    let countdown = 5
    const countdownEl = document.getElementById("countdown")

    const interval = setInterval(() => {
      countdown--
      if (countdownEl) {
        countdownEl.textContent = String(countdown)
      }
      if (countdown <= 0) {
        clearInterval(interval)
        window.location.href = "/"
      }
    }, 1000)

    setTimeout(() => {
      if (countdown > 0) {
        clearInterval(interval)
        window.location.href = "/"
      }
    }, 5000)
  </script>

  <div class="flex min-h-[80vh] flex-col items-center justify-center px-4 text-center">
    <div class="mb-12">
      <h1 class="text-gradient mb-4 text-7xl font-bold md:text-8xl">404</h1>
      <p class="mb-4 text-2xl font-semibold text-[var(--color-text)]">Page not found</p>
      <p class="text-lg text-[var(--color-text-muted)]">
        The page you're looking for doesn't exist.
      </p>
    </div>

    <div class="mb-8 space-y-4">
      <p class="text-lg text-[var(--color-text)]">
        Redirecting to home page in <span id="countdown" class="font-bold text-gradient">5</span> seconds...
      </p>
      <a
        href="/"
        class="inline-block bg-gradient-primary px-8 py-3 rounded-full font-semibold text-white transition-opacity duration-300 hover:opacity-90"
      >
        Go Home Now
      </a>
    </div>
  </div>
</Layout>
