{
  "name": "mcarn.github.io",
  "type": "module",
  "version": "0.0.38",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint \"src/**/*.{js,astro,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,astro,ts,tsx}\" --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:json": "prettier --write \"**/*.json\"",
    "astro:upgrade": "pnpm dlx @astrojs/upgrade",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/markdoc": "^2.0.9",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.49.0",
    "@playform/compress": "^0.2.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-embed": "^0.14.0",
    "astro-seo": "^1.2.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-astro-organize-imports": "^0.4.13",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vercel/speed-insights",
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
